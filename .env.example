# ==========================================================================
# Variables de entorno — Villarroel & Asociados
# Copiá este archivo como .env y completá los valores.
# ==========================================================================

# --- Base de datos ---
# DESARROLLO local (SQLite, sin instalar nada):
DATABASE_URL="file:./dev.db"
# PRODUCCIÓN (Neon / Postgres) — reemplazar en Vercel y cambiar el provider
# en prisma/schema.prisma a "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Autenticación del panel /admin ---
# Secreto para firmar la cookie de sesión (string largo y aleatorio).
AUTH_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio"
# Credenciales del administrador único.
ADMIN_EMAIL="admin@villarroelyasociados.com.ar"
# Contraseña inicial (se hashea al hacer el seed; luego se puede cambiar en el panel).
ADMIN_PASSWORD="cambiar-esta-contrasena"

# --- Email (Resend) — se usa en la Etapa 7 ---
RESEND_API_KEY=""
# Remitente verificado en Resend (al inicio puede ser onboarding@resend.dev).
EMAIL_FROM="Villarroel & Asociados <onboarding@resend.dev>"

# --- Almacenamiento de imágenes (Vercel Blob) — se usa en la Etapa 3 ---
# En desarrollo local, si está vacío, las imágenes se guardan en /public/uploads.
BLOB_READ_WRITE_TOKEN=""

# --- URL pública del sitio (para canonical, sitemap y Open Graph) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
